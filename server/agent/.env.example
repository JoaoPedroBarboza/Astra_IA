# Copie para .env e preencha com os valores reais.
# O .env fica fora do git — nunca comite este arquivo preenchido.

# LiveKit (mesmo projeto usado pelo client)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI — voz em tempo real (gpt-realtime-2.1-mini), pesquisa na internet e títulos
OPENAI_API_KEY=

# Mem0 — memória de longo prazo do agente
MEM0_API_KEY=

# Planos, consumo e histórico — o agente reporta os tokens de cada sessão ao app, que
# aplica os limites do plano, e grava as falas no histórico de conversas. Sem estas
# duas, o consumo NÃO é medido nem limitado e a conversa NÃO vai para o histórico.
# URL do app Next.js (local: http://localhost:3000; produção: o domínio da Vercel).
ASTRA_APP_URL=
# O mesmo valor de ASTRA_AGENT_SECRET do client/.env.local.
ASTRA_AGENT_SECRET=

# Opcionais — trocar modelos sem mudar código.
# Voz (padrão: gpt-realtime-2.1-mini). gpt-realtime-mini volta ao anterior até 20/01/2027.
# ASTRA_MODELO_VOZ=
# Pesquisa na internet (padrão: gpt-5.4-mini). Ao trocar, ajuste BUSCA_WEB em
# client/lib/planos.ts, que tem os preços deste modelo.
# ASTRA_MODELO_BUSCA=
# Título das conversas do histórico (padrão: gpt-5.4-mini). Precisa aceitar o parâmetro
# "reasoning" (modelos gpt-5.x ou mais novos).
# ASTRA_MODELO_TITULO=
