# Copie para .env e preencha com os valores reais.
# O .env fica fora do git — nunca comite este arquivo preenchido.

# LiveKit (mesmo projeto usado pelo client)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI — modelo de voz em tempo real (gpt-realtime-mini)
OPENAI_API_KEY=

# Mem0 — memória de longo prazo do agente
MEM0_API_KEY=

# Planos, consumo e histórico — o agente reporta os tokens de cada sessão ao app, que
# aplica os limites do plano, e grava as falas no histórico de conversas. Sem estas
# duas, o consumo NÃO é medido nem limitado e a conversa NÃO vai para o histórico.
# URL do app Next.js (local: http://localhost:3000; produção: o domínio da Vercel).
ASTRA_APP_URL=
# O mesmo valor de ASTRA_AGENT_SECRET do client/.env.local.
ASTRA_AGENT_SECRET=

# Opcional — modelo de texto que dá título às conversas do histórico (padrão: gpt-4o-mini).
# ASTRA_MODELO_TITULO=
