# Copie este arquivo para .env.local e preencha. Na Vercel, cadastre as mesmas
# variáveis em Settings → Environment Variables.

# LiveKit — MESMO projeto usado pelo agente em server/agent/.env.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Postgres (Neon). Use a connection string "pooled" (host com -pooler).
DATABASE_URL=

# Planos e consumo.
# Segredo compartilhado com o agente (server/agent/.env): é com ele que o agente
# reporta o consumo em /api/uso. Gere com: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ASTRA_AGENT_SECRET=
# E-mails com plano Núcleo (administrador, sem limites), separados por vírgula.
ADMIN_EMAILS=

# Better Auth. Gere o segredo com: npx auth@1.7.15 secret
BETTER_AUTH_SECRET=
# URL pública do app (em produção, o domínio da Vercel).
BETTER_AUTH_URL=http://localhost:3000

# Login com Google (opcional — sem estas duas, o botão não aparece).
# Redirect URI no Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP para os códigos de verificação. Em dev, se SMTP_HOST ficar vazio, o código
# aparece no terminal do `npm run dev`. Em produção é obrigatório.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Astra IA <no-reply@seudominio.com>"
